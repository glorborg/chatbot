# App Configuration
APP_URL=http://localhost:3000
APP_ACCESS_CODE=your_secret_access_code_here
TIMEZONE=America/Chicago

# Limits & Guardrails
BOT_LIMIT=20
DOMAINS_PER_BOT=10
ACCOUNT_DOMAIN_CAP=50
CRAWL_MAX_PAGES=10
DOC_MAX_PAGES=20
MAX_SOURCE_SIZE_MB=10
RATE_MSGS_PER_MIN=20
RATE_MSGS_PER_DAY=200
COST_ALERT_USD=10
DELETE_RAW_AFTER_INDEXING=true

# OpenAI Integration
OPENAI_API_KEY=your_openai_api_key_here
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Supabase (Database & Storage)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Email (SMTP) - Optional for now
EMAIL_FROM="Bot Builder <no-reply@yourdomain.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Cron Protection
CRON_SECRET=your_cron_secret_here

# Admin Emails (comma-separated)
ADMIN_EMAILS=admin@greymouse.ai

# Session Secret (for JWT signing)
SESSION_SECRET=your_random_secret_for_jwt_signing
